# Copy to .env and fill in your own credentials. Never commit .env.
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@example.com
APP_URL=https://your-domain.example/source-code

# Generate hashes using: php -r "echo password_hash('YOUR_NEW_PASSWORD', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=replace_with_generated_hash
# Current schema has no per-stylist password column: this is a shared temporary password.
STYLIST_PASSWORD_HASH=replace_with_generated_hash
